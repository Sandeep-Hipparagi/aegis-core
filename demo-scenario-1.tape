Output assets/demo-scenario-1.gif

Set Width 1040
Set Height 520
Set Padding 22
Set BorderRadius 12
Set Margin 20
Set MarginFill "#0d1117"
Set FontFamily "SF Mono"
Set FontSize 15
Set LineHeight 1.3
Set Theme "Catppuccin Mocha"
Set TypingSpeed 40ms
Set CursorBlink true

Hide
Type "prompt $G "
Enter
Type "cls"
Enter
Sleep 300ms
Show

Type "aegis intercept --tool execute_db_query --target users.credentials"
Sleep 400ms
Enter

Sleep 5.5s
