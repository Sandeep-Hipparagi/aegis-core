{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "io.github.Sandeep-Hipparagi/aegiscore",
  "title": "AegisCore",
  "description": "Deterministic zero-trust policy enclave and cryptographic WORM audit ledger for MCP tools.",
  "version": "0.1.3",
  "websiteUrl": "https://github.com/Sandeep-Hipparagi/aegis-core",
  "repository": {
    "type": "git",
    "url": "https://github.com/Sandeep-Hipparagi/aegis-core.git",
    "source": "github"
  },
  "packages": [
    {
      "registryType": "npm",
      "identifier": "@aegiscore-ai/core",
      "version": "0.1.3",
      "transport": {
        "type": "stdio"
      },
      "runtimeHint": "npx",
      "packageArguments": [
        {
          "type": "positional",
          "value": "mcp"
        }
      ]
    },
    {
      "registryType": "pypi",
      "identifier": "aegiscore-ai",
      "version": "0.1.3",
      "transport": {
        "type": "stdio"
      }
    }
  ]
}
