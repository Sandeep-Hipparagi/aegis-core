{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": ["ES2022"],
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "declaration": true,
    "outDir": "./dist",
    "baseUrl": ".",
    "paths": {
      "@aegiscore-ai/core": ["./core/src/index.ts"],
      "@aegiscore-ai/sdk": ["./sdk/src/index.ts"],
      "@aegiscore/core": ["./core/src/index.ts"],
      "@aegiscore/sdk": ["./sdk/src/index.ts"]
    }
  },
  "include": [
    "core/src/**/*",
    "sdk/src/**/*",
    "examples/**/*"
  ],
  "exclude": ["node_modules", "dist"]
}
